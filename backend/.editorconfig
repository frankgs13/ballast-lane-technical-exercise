root = true

[*.cs]
indent_style = space
indent_size = 4
charset = utf-8
insert_final_newline = true
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# ASP.NET Core has no SynchronizationContext; ConfigureAwait(false) is noise here.
dotnet_diagnostic.CA2007.severity = none

[tests/**.cs]
# Method_Scenario_ExpectedResult is the conventional test naming style.
dotnet_diagnostic.CA1707.severity = none
# xUnit test classes must be public.
dotnet_diagnostic.CA1515.severity = none
# Literal strings in test assertions do not need localization or culture handling.
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2000.severity = none
# Fixtures are disposed by xUnit through IAsyncLifetime.
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA2234.severity = none
