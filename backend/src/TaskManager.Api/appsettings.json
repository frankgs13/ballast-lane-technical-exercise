{
  "ConnectionStrings": {
    "TaskManager": "Server=(localdb)\\MSSQLLocalDB;Database=TaskManager;Integrated Security=true;TrustServerCertificate=true"
  },
  "Database": {
    "InitializeOnStartup": false,
    "SeedDemoData": false
  },
  "Jwt": {
    "Issuer": "TaskManager.Api",
    "Audience": "TaskManager.Client",
    "SigningKey": "",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "WindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
